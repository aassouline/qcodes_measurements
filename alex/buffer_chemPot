SENSITIVITY = 0.05  # V, lock-in sensitivity
FREQUENCY = 1.33e3  # Hz, lock-in reference frequency

# ---- slow axis gate (ITest DAC, ch01) ----
DAC_RAMP_SLOPE = 0.01   # V/ms

# ---- fast axis gate (Yokogawa GS200) ----
GS200_VOLTAGE_RANGE = 10.0   # V, safe range for your gate

# ---- sweep definition ----
VG_VALUES = np.linspace(0.0, 0.001, 10)   # slow axis (top gate) values -- placeholder, single point
VDC_MIN = -2.6                          # V, fast axis (bottom gate) sweep start
VDC_MAX = -2.8                          # V, fast axis (bottom gate) sweep end
VDNSTEP = 100                             # number of fast-axis points per line

# ---- timing (all derived from TCLOCKIN by default -- override directly if needed) ----
TSL = 30e-3     # dwell time per fast-axis point
T_SKIP = 3 * TCLOCKIN   # settle time after each step before trusting the lock-in output
TWAIT = 10 * TCLOCKIN   # settle time after moving the slow axis, before a fast-axis line

# Capture rate is tied to TCLOCKIN, not to TSL: samples taken much faster than the
# filter's own correlation time (~TCLOCKIN) aren't independent, so packing in more of
# them buys little/no real noise reduction while still costing buffer memory and
# transfer time. SAMPLES_PER_TCLOCKIN sets the density where averaging is still
# genuinely useful; how many of those samples land in a given dwell (TSL - T_SKIP)
# then follows automatically -- no separate oversampling knob to keep in sync by hand.
SAMPLES_PER_TCLOCKIN = 5   # independent-ish samples per lock-in time constant

# ---- calibration settings ----
CALIB_N_POINTS = 5             # number of calibration steps (spans VDC_MIN to VDC_MAX)

# CALIB_SETTLE_TIME scales with TCLOCKIN (not a fixed absolute value) for the
# same reason TSL/T_SKIP/TWAIT do: a fixed 1.0s settle_time combined with a
# capture rate that scales as 1/TCLOCKIN means the required buffer size
# (~ rate * duration) scales as 1/TCLOCKIN too -- shrink TCLOCKIN enough and
# the calibration buffer blows past the instrument's 4096 kB hardware limit
# (this happened: 14650 kB requested at TCLOCKIN small enough). Scaling
# settle_time WITH TCLOCKIN makes rate*duration -- and therefore the
# required buffer size -- independent of TCLOCKIN entirely, so this can't
# recur regardless of how TCLOCKIN is tuned later.
CALIB_SETTLE_TIME = 300 * TCLOCKIN   # s, wait after each calibration step -- must
                                       # comfortably exceed the real device's settling
                                       # time (check fitted tau values; widen the 300x
                                       # multiplier if fits look poor/inconsistent)

# Calibration's capture rate must resolve the TRANSIENT itself, not just fit
# "enough total samples" into the settle_time window -- tying rate to
# TCLOCKIN (like the main sweep's SAMPLES_PER_TCLOCKIN) keeps sampling dense
# regardless of settle_time.
CALIB_SAMPLES_PER_TCLOCKIN = 50   # denser than the main sweep's 5, since a clean
                                   # fit needs good resolution ON the transient itself

