def gs200_set_fast(v):
	"""
	Direct SCPI write, bypassing gs200.voltage()'s per-call ':SOUR:RANG?'
	query. QCoDeS's driver re-queries the instrument's current range EVERY
	single .voltage() call to safety-check the value -- doubling the VISA
	round-trips per point and, empirically, occasionally timing out
	mid-sweep and crashing the measurement entirely. Since the range is set
	once above and never changes, that per-call query is pure unnecessary
	overhead (and a recurring failure point) -- use this instead anywhere
	speed/reliability matters, after validating values are in-range ONCE up
	front (see the validation right after Vdc/calib_voltages are defined).
	"""
	gs200.write(f':SOUR:LEV {v:.6f}')


