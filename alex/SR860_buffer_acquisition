###############################################################################
#                    LOCK-IN BUFFER SETUP (fast axis readout)
###############################################################################

buf = lockin_B.buffer
buf.capture_config("X,Y")

n_oversample = 10                       # samples captured per gate step (tune as needed)
target_rate  = n_oversample / tsl       # desired capture rate [Hz]
buf.capture_rate(target_rate)           # rounds to nearest valid rate (max_rate / 2^n)
print(f'SR860 buffer capture rate: {buf.capture_rate():.3f} Hz '
	  f'(requested {target_rate:.3f} Hz)')

# Size the buffer generously for one full j-sweep, with margin for VISA/ramp overhead
_margin = 2.0
max_expected_samples = int(np.ceil(buf.capture_rate() * Vdnstep * tsl * _margin))
buf.set_capture_length_to_fit_samples(max_expected_samples)
print(f'Buffer sized for {max_expected_samples} samples '
	  f'({buf.capture_length_in_kb()} kB)')

t_skip = 2 * tclockin   # settle time after each gate step before trusting the lock-in output


############################## Measurement ##################################


time_start = time.time()

parameter_snap={}

print(f'database name : {database_name}')

yoko.ramp_voltage( Vg[0], 0.2, 0.01)
yoko2.ramp_voltage( Vdc[0], 0.2, 0.01)

with meas.run() as datasaver:

	id=datasaver.dataset.run_id

	qc.load_by_run_spec( captured_run_id=id).add_metadata('parameter_snap',
						 json.dumps(parameter_snap))

	time0 = time.time()
	current_time = time.time() - time0

	for i, valg in enumerate(Vg) :

		yoko.ramp_voltage( valg, 100, 0.01)

		Vdmin = -(valg + V0t) * bothBN / tophBN - V0b - dV
		Vdmax = -(valg + V0t) * bothBN / tophBN - V0b + dV
		Vdc = np.linspace(Vdmin, Vdmax, Vdnstep)  # yoko2  Bottom gate   FAST AXIS

		yoko2.ramp_voltage( Vdc[0], 100, 0.01)

		if i==0:
			time.sleep(5.0)

		time.sleep(twait)

		# ---- start buffered capture for this whole j-sweep ----
		buf.start_capture("CONT", "IMM")
		t_start = time.perf_counter()

		timestamps = np.zeros(Vdnstep)

		for j, valdc in enumerate(Vdc):

			yoko2.ramp_voltage( valdc, 100, 0.01)
			timestamps[j] = time.perf_counter()
			time.sleep(tsl)

		t_end = time.perf_counter()
		buf.stop_capture()

		# ---- retrieve the whole line in one shot ----
		actual_bytes   = buf.count_capture_bytes()
		actual_samples = actual_bytes // (2 * buf.bytes_per_sample)   # 2 channels: X, Y
		data   = buf.get_capture_data(actual_samples)
		X_buf, Y_buf = data["X"], data["Y"]
		sample_times = t_start + np.arange(len(X_buf)) / buf.capture_rate()

		# ---- bin buffer samples onto each gate step ----
		X_binned = np.full(Vdnstep, np.nan)
		Y_binned = np.full(Vdnstep, np.nan)

		for j in range(Vdnstep):
			t0 = timestamps[j] + t_skip
			t1 = timestamps[j + 1] if j + 1 < Vdnstep else t_end
			mask = (sample_times >= t0) & (sample_times < t1)
			if mask.any():
				X_binned[j] = X_buf[mask].mean()
				Y_binned[j] = Y_buf[mask].mean()
			else:
				# fallback if the window was too short to contain a sample
				idx = np.argmin(np.abs(sample_times - timestamps[j]))
				X_binned[j] = X_buf[idx]
				Y_binned[j] = Y_buf[idx]

		# ---- push the line into the dataset ----
		for j, valdc in enumerate(Vdc):

			current_time = timestamps[j] - time0

			datasaver.add_result((lockin_B.X, X_binned[j]),
								  (lockin_B.Y, Y_binned[j]),
								  ('Vbot', valdc),
								  ('Vtop', valg),
								  ('Time', current_time))

current_time = time.time() 

print ('time measurement:', current_time-time_start, 's')
