meas.register_custom_parameter('lockin_B_X', setpoints=['Vdc', 'Vg'])
meas.register_custom_parameter('lockin_B_Y', setpoints=['Vdc', 'Vg'])

meas.register_custom_parameter('lockin_A_X', setpoints=['Vdc', 'Vg'])
