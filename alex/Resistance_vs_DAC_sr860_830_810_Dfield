Vgain=100
Igain=1e7


############################## Measurement ##################################


time_start = time.time()

parameter_snap={}

print(f'database name : {database_name}')

#yoko2.ramp_voltage(Vdc[0], 0.2, 0.01)
dac.StartSweep(channel=islowaxis, target=int(Vg[0] * 52428.8), r=100000)
dac.StartSweep(channel=ifastaxis, target=int(Vdc[0] * 52428.8), r=100000)

if np.abs(Vg[0])<np.abs(Vdc[0]) or np.abs(Vg[0])==np.abs(Vdc[0]):
	time.sleep(np.abs(Vdc[0])/0.1)

if np.abs(Vg[0])>np.abs(Vdc[0]):
	time.sleep(np.abs(Vg[0])/0.1)

with meas.run() as datasaver:

	id=datasaver.dataset.run_id

	qc.load_by_run_spec( captured_run_id=id).add_metadata('parameter_snap',
						 json.dumps(parameter_snap))

	time0 = time.time()
	current_time = time.time() - time0

	for i, valg in enumerate(Vg) :

		#yoko2.ramp_voltage(Vdc[0], 0.2, 0.01)
		dac.StartSweep(channel=islowaxis, target=int(valg * 52428.8), r=100000)

		Vdmin = -(valg + V0t) * rbn - V0b - dV
		Vdmax = -(valg + V0t) * rbn - V0b + dV
		Vdc = np.linspace(Vdmin, Vdmax, Vdnstep)  # this if for   FAST AXIS


		dac.StartSweep(channel=ifastaxis, target=int(Vdc[0] * 52428.8), r=100000)

		time.sleep(np.abs(Vdc[-1]-Vdc[0])/0.1)

		if i==0:
			time.sleep(5.0)

		time.sleep(twait)

		for j, valdc in enumerate(Vdc) :

			dac.ChangeVout(channel=ifastaxis, vb=int(valdc * 52428.8))
			#yoko2.ramp_voltage(valdc, 0.2, 0.01)

			time.sleep(tsl+trc)

			#V_X2_B = lockin_B.X()  # voltage X
			#V_Y2_B = lockin_B.Y()  # voltage Y
			V_X2_A, V_Y2_A = lockin_A.snap("X","Y")  #
			V_X2_B, V_Y2_B = lockin_B.get_values("X","Y")  # 
			V_X2_C, V_Y2_C = lockin_C.snap("X","Y")  #

			cons_current=200e-3/11/1e7
			Rxy_p=V_X2_C/Vgain/cons_current

			current_time = time.time() - time0  # elapsed time
			datasaver.add_result(('lockin_B_X', V_X2_B),
								 ('lockin_B_Y', V_Y2_B),
								 ('lockin_A_X', V_X2_A),
								 ('lockin_A_Y', V_Y2_A),
								 ('lockin_C_X', V_X2_C),
								 ('lockin_C_Y', V_Y2_C),
								 ('Rxy_X', Rxy_p),
								 ('Vdc', valdc),
								 ('Vg', valg),
								 ('Time', current_time))

current_time = time.time() 

